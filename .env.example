# ====== Telegram ======
# 1) Crie um bot com @BotFather no Telegram para obter o token
# 2) Adicione o bot ao canal/grupo como admin com permissao de postar
# 3) Pegue o chat_id (negativo para grupos/canais)
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ====== Google Gemini (gratuito) - https://aistudio.google.com/apikey ======
GEMINI_API_KEY=sua_chave_aqui

# ====== Groq (backup AI - opcional) - https://console.groq.com/keys ======
GROQ_API_KEY=

# ====== Amazon Associados (link afiliado) ======
AMAZON_ASSOCIATE_TAG=seutag-20

# ====== Banco PostgreSQL ======
DB_URL=jdbc:postgresql://localhost:5432/promobot
DB_USERNAME=postgres
DB_PASSWORD=troque_aqui
